rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to upload verification documents to their own folder.
    // The path format is: verification-documents/{userType}/{userId}/{fileName}
    match /verification-documents/{userType}/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to upload and manage PDF shipment documents.
    // The path format is: shipments/{shipmentId}/{allPaths=**}
    match /shipments/{shipmentId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null 
                            && request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null;
    }
  }
}
